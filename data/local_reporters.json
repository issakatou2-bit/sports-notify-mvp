  "posts": [
    {
      "handle": "nightengalejr.bsky.social",
      "author": "Bobby Nightengale",
      "team": "ツインズ",
      "outlet": "Star Tribune",
      "text": "Wow. The Twins signed Sonny Gray to a two-year deal. Rotation should be a big strength next year.",
      "likes": 63,
      "reposts": 7,
      "replies": 3,
      "at": "2026-11-18T20:37:49.136Z",
      "uri": "at://did:plc:gtt6sqfv2lck4wxdxymmhrxk/app.bsky.feed.post/3n2mfxzlh622g",
      "jp_players": [],
      "jp": "すごい。ツインズがソニー・グレイと2年契約。来季は先発陣が大きな強みになりそうだ。"
    },
    {
      "handle": "keeganmatheson.bsky.social",
      "author": "Keegan Matheson",
      "team": "ブルージェイズ",
      "outlet": "MLB.com",
      "text": "Vladimir Guerrero Jr. told media in the Dominican Republic that, when he was traded (in LIDOM) to Tigres del Licey yesterday, his daughter cried because she thought that it was from the #BlueJays He says he wants to play for Dominican fans who can’t see him play in-person in MLB",
      "likes": 59,
      "reposts": 3,
      "replies": 1,
      "at": "2026-11-19T01:54:16.750Z",
      "uri": "at://did:plc:wwjv37n37xrozzfku6zvduez/app.bsky.feed.post/3n2mxnvlfyc2k",
      "jp_players": [],
      "jp": "ゲレーロJr.がドミニカの記者団に語った。昨日LIDOMでティグレス・デル・リセイへトレードされた際、娘は#BlueJaysからの放出だと思って泣いたという。MLBの現地観戦ができないドミニカのファンのためにプレーしたいと話す。"
    },
    {
      "handle": "keeganmatheson.bsky.social",
      "author": "Keegan Matheson",
      "team": "ブルージェイズ",
      "outlet": "MLB.com",
      "text": "Down in the Dominican Winter League (LIDOM) … and I can not stress enough that this is a tweet about the Dominican Winter League (LIDOM): Vladimir Guerrero Jr. was traded from Toros del Este to Tigres del Licey. Guerrero has not played in LIDOM games since 2020-21. #BlueJays",
      "likes": 54,
      "reposts": 4,
      "replies": 4,
      "at": "2026-11-18T01:51:36.645Z",
      "uri": "at://did:plc:wwjv37n37xrozzfku6zvduez/app.bsky.feed.post/3n2kh27gnh22p",
      "jp_players": [],
      "reply_texts": [
        {
          "text": "They might try change the name to the Tigres Centre, but it’ll always be called the LIDOMe",
          "likes": 3,
          "author": "bradc.bsky.social"
        },
        {
          "text": "Vladimir Guerrero Jr. traded!!!!!1!!!!\n\n(God, does putting a random 1 into a block of !s even scan any more?)",
          "likes": 3,
          "author": "cannedlizard.bsky.social"
        },
        {
          "text": "Shatkins!",
          "likes": 1,
          "author": "buck16.bsky.social"
        },
        {
          "text": "What did the Bulls get in return? Was the purpose of this trade entirely so they could freak out Blue Jays fans by announcing \"Guerrero traded to Tigers\"?",
          "likes": 0,
          "author": "chamale.bsky.social"
        }
      ],
      "jp": "ドミニカのウインターリーグ(LIDOM)の話であることを強調しておく。ゲレーロJr.がトロス・デル・エステからティグレス・デル・リセイへトレードされた。LIDOMでのプレーは2020-21年以来。#BlueJays"
    },
    {
      "handle": "nightengalejr.bsky.social",
      "author": "Bobby Nightengale",
      "team": "ツインズ",
      "outlet": "Star Tribune",
      "text": "MLB announced the Twins (and the Twins community fund’s Girls Belong in Baseball initiative) are the 2026 winners for the Selig Award for Philanthropic Excellence. Per the news release, 1,134 girls registered for free Twins community fund youth baseball clinics this year.",
      "likes": 25,
      "reposts": 2,
      "replies": 0,
      "at": "2026-11-18T17:22:32.207Z",
      "uri": "at://did:plc:gtt6sqfv2lck4wxdxymmhrxk/app.bsky.feed.post/3n2m32th5os2z",
      "jp_players": [],
      "jp": "MLBが発表。ツインズ(とツインズ・コミュニティ基金の「Girls Belong in Baseball」)が2026年のセリグ賞(慈善活動部門の功績賞)を受賞。今年、無料の少年野球教室に1,134人の少女が登録した。"
    },
    {
      "handle": "jasonbeck.bsky.social",
      "author": "Jason Beck",
      "team": "タイガース",
      "outlet": "MLB.com",
      "text": "On the flip side, Maikel Garcia and his .920 OPS vs. Tigers are no longer in the AL Central.",
      "likes": 19,
      "reposts": 4,
      "replies": 0,
      "at": "2026-11-18T16:43:06.641Z",
      "uri": "at://did:plc:ug2irz5m3k7nlbpiggqc73wt/app.bsky.feed.post/3n2lyudhsnc2j",
      "jp_players": [],
      "jp": "逆に、マイケル・ガルシアとタイガース戦OPS.920は、もうア・リーグ中地区にはいない。"
    },
    {
      "handle": "samdykstramilb.bsky.social",
      "author": "Sam Dykstra",
      "team": "全国",
      "outlet": "MLB Pipeline",
      "text": "There are sadly no Minor League Baseball teams in the great state of Alaska BUT YOU SHOULD LEARN ABOUT THE MIDNIGHT SUN GAME ALL THE SAME (via the great @mattmonagan.bsky.social): www.mlb.com/news/what-is...",
      "likes": 22,
      "reposts": 1,
      "replies": 1,
      "at": "2026-11-18T03:33:51.226Z",
      "uri": "at://did:plc:bdxjovzqrf4q66ptu3dplmeb/app.bsky.feed.post/3n2kmqztd4c24",
      "jp_players": [],
      "jp": "アラスカ州にはマイナーリーグの球団はないが、それでもミッドナイト・サン・ゲームについては知っておくべき。(@mattmonagan.bsky.socialより)"
    },
    {
      "handle": "mmontemurro.bsky.social",
      "author": "Meghan Montemurro",
      "team": "カブス",
      "outlet": "Chicago Tribune",
      "text": "The Cubs have added RHP Jaxon Wiggins and RHP Brody McCullough to the 40-man roster, protecting them from the Rule 5 draft (if it happens). Cubs' 40-man roster now stands at 36 players.",
      "likes": 18,
      "reposts": 3,
      "replies": 0,
      "at": "2026-11-18T00:03:56.326Z",
      "uri": "at://did:plc:nbtbg72x4ai35yy2mmx4o2mb/app.bsky.feed.post/3n2kazoff5k2u",
      "jp_players": [],
      "jp": "カブスがジャクソン・ウィギンス投手とブロディ・マカラ投手を40人枠に加え、ルール5ドラフト(実施される場合)の対象から外した。40人枠は36人に。"
    },
    {
      "handle": "timbhealey.bsky.social",
      "author": "Tim Healey",
      "team": "レッドソックス",
      "outlet": "Boston Globe",
      "text": "Source: The Red Sox are acquiring catcher Nick Fortes from the Rays for minor league righthander Angel Roa.",
