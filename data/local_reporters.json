      "uri": "at://did:plc:hqnn3kfpfuhkhv2b4izkrzpa/app.bsky.feed.post/3mzcawz5nrc2c",
      "jp_players": [],
      "reply_texts": [
        {
          "text": "Good for him.  He definitely wasn’t getting the Silver Slugger.",
