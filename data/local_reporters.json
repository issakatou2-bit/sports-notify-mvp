    {
      "handle": "jasonbeck.bsky.social",
      "author": "Jason Beck",
      "team": "タイガース",
      "outlet": "MLB.com",
      "text": "Cade Cunningham had a night (yes, I know it was double OT).",
      "likes": 28,
      "reposts": 4,
